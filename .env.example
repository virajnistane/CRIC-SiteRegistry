# Django settings
# SECURITY WARNING: Generate a new SECRET_KEY for production!
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings
# SECURITY WARNING: Change these credentials for production!

# === FOR DOCKER (default configuration) ===
# Use these values when running: docker compose up
POSTGRES_NAME=site_registry
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === FOR LOCAL DEVELOPMENT ===
# Uncomment and use these instead when running Django locally
# (requires Docker PostgreSQL running: docker compose up -d db)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
